// app.rc — application resources
//
// The VERSIONINFO block below is populated entirely from Version.h, so the
// version Explorer shows in the EXE's Properties -> Details tab can never
// drift from the version the app reports about itself.
//
// NOTE: edit this file as *text*, not through the Visual Studio resource
// editor. The editor rewrites .rc files it opens and will hoist or mangle
// the #include of Version.h into a TEXTINCLUDE block. The stale app.aps
// cache sitting next to this file is the editor's doing; deleting it is
// safe and stops it re-importing an old view of these resources.

#include <windows.h>
#include "Version.h"

IDI_ICON1 ICON "installer\\logo-icon-nobackground.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MOULD3R_VERSION_COMMAS
 PRODUCTVERSION MOULD3R_VERSION_COMMAS
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"                        // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      MOULD3R_COMPANY_NAME
            VALUE "FileDescription",  MOULD3R_FILE_DESCRIPTION
            VALUE "FileVersion",      MOULD3R_VERSION_STRING
            VALUE "InternalName",     "Mould3r.exe"
            VALUE "LegalCopyright",   MOULD3R_COPYRIGHT
            VALUE "OriginalFilename", "Mould3r.exe"
            VALUE "ProductName",      MOULD3R_PRODUCT_NAME
            VALUE "ProductVersion",   MOULD3R_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200        // must match the block above
    END
END
